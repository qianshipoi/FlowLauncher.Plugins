{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}\\FlowLauncher.Plugins.slnx",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-stt-plugin",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}\\src\\FlowLauncher.Plugin.SpeechToText\\FlowLauncher.Plugin.SpeechToText.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}\\FlowLauncher.Plugins.slnx"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": [
        "restore",
        "${workspaceFolder}\\FlowLauncher.Plugins.slnx"
      ],
      "problemMatcher": []
    },
    {
      "label": "test-all",
      "command": "dotnet",
      "type": "process",
      "args": [
        "test",
        "${workspaceFolder}\\FlowLauncher.Plugins.slnx",
        "--no-restore",
        "--verbosity",
        "normal"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
