<Window x:Class="FlowLauncher.Plugin.Toolbox.JsonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:webview2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="JSON 编辑器 - Toolbox"
        Width="1100" Height="750"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3">
    <shell:WindowChrome.WindowChrome>
        <!-- GlassFrameThickness 不能为 0，否则 DWM 窗口阴影会消失 -->
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="1"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#444" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#B0B0B0" BorderThickness="1" Background="#F3F3F3">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Height="36"
                Background="#F3F3F3"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel>
                <Image Source="Resources/app.ico"
                       Width="16" Height="16"
                       Margin="10,0,6,0"
                       DockPanel.Dock="Left"
                       shell:WindowChrome.IsHitTestVisibleInChrome="True"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- 固定：图钉（Path，不依赖图标字体） -->
                    <Button x:Name="PinButton"
                            Style="{StaticResource CaptionButton}"
                            Click="Pin_Click"
                            ToolTip="固定到最前">
                        <Canvas Width="14" Height="14">
                            <Path x:Name="PinGlyph"
                                  Data="M 7,0.5 L 10.5,4 L 10.5,7.5 L 12,9 L 9,9 L 9,13.5 L 5,13.5 L 5,9 L 2,9 L 3.5,7.5 L 3.5,4 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Canvas>
                    </Button>

                    <Button Style="{StaticResource CaptionButton}"
                            Click="Minimize_Click"
                            ToolTip="最小化">
                        <Path Data="M 2,7 H 12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" />
                    </Button>

                    <Button x:Name="MaximizeButton"
                            Style="{StaticResource CaptionButton}"
                            Click="Maximize_Click"
                            ToolTip="最大化">
                        <Path x:Name="MaximizeGlyph"
                              Data="M 2,2 H 12 V 12 H 2 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Fill="Transparent" />
                    </Button>

                    <Button Style="{StaticResource CaptionButton}"
                            Click="Close_Click"
                            ToolTip="关闭">
                        <Path Data="M 3,3 L 11,11 M 11,3 L 3,11"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5" />
                    </Button>
                </StackPanel>

                <TextBlock Text="JSON 编辑器"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#1A1A1A"
                           shell:WindowChrome.IsHitTestVisibleInChrome="True"
                           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" />
            </DockPanel>
        </Border>

        <webview2:WebView2 x:Name="WebView" />
    </DockPanel>
    </Border>
</Window>
