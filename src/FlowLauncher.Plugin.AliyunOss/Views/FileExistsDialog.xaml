<Window
    x:Class="FlowLauncher.Plugin.AliyunOss.Views.FileExistsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="文件已存在"
    Width="400"
    Height="180"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock
            x:Name="MessageText"
            FontSize="14"
            TextWrapping="Wrap"
            Margin="0,0,0,16" />
        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
            <Button
                x:Name="BtnBackupReplace"
                Width="110"
                Margin="0,0,8,0"
                Padding="8,6"
                Click="BtnBackupReplace_Click"
                Content="备份并替换" />
            <Button
                x:Name="BtnReplace"
                Width="90"
                Margin="0,0,8,0"
                Padding="8,6"
                Click="BtnReplace_Click"
                Content="直接替换" />
            <Button
                Width="70"
                Padding="8,6"
                Click="BtnCancel_Click"
                Content="取消" />
        </StackPanel>
    </StackPanel>
</Window>
