<Window
    x:Class="FlowLauncher.Plugin.AliyunOss.Views.FileBrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlowLauncher.Plugin.AliyunOss.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlowLauncher.Plugin.AliyunOss.ViewModel"
    Title="OSS 文件浏览器"
    Width="900"
    Height="600"
    d:DataContext="{d:DesignInstance Type=viewmodel:FileBrowserViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CardBorder"
                TargetType="Border">
            <Setter Property="Background"
                    Value="#FAFBFC"/>
            <Setter Property="BorderBrush"
                    Value="#E1E4E8"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="Padding"
                    Value="16"/>
        </Style>
        <Style x:Key="SectionHeader"
                TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Foreground"
                    Value="#24292F"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LinkText"
                TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#0969DA"/>
            <Setter Property="TextWrapping"
                    Value="Wrap"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontFamily"
                    Value="Consolas"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏：桶名、前缀、加载按钮 -->
        <Border Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#57606A"
                    Text="桶名:"/>
                <TextBox
                    Grid.Column="1"
                    Padding="8,6"
                    FontSize="13"
                    Text="{Binding BucketName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#57606A"
                    Text="前缀:"/>
                <TextBox
                    Grid.Column="4"
                    Padding="8,6"
                    FontSize="13"
                    Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}"/>

                <Button
                    Grid.Column="6"
                    Padding="16,6"
                    Command="{Binding LoadObjectsCommand}"
                    Content="加载"
                    FontSize="13"
                    IsDefault="True"/>

                <CheckBox
                    Grid.Column="8"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="#57606A"
                    Content="上传后自动复制链接"
                    IsChecked="{Binding AutoCopyLink}"/>
            </Grid>
        </Border>

        <!-- 当前路径 + 返回上级 -->
        <StackPanel Grid.Row="1"
                Orientation="Horizontal">
            <Button
                Padding="12,6"
                Click="BtnBack_Click"
                Content="⬆ 返回上级"
                FontSize="13"
                FontWeight="SemiBold"/>
            <TextBlock
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="#57606A"
                Text="{Binding Prefix, Mode=OneWay}"/>
        </StackPanel>

        <!-- 主内容区：文件列表 + 拖拽上传 -->
        <Border
            Grid.Row="3"
            x:Name="DropZone"
            AllowDrop="True"
            Drop="DropZone_Drop"
            DragEnter="DropZone_DragEnter"
            DragLeave="DropZone_DragLeave">
            <Border.Style>
                <Style TargetType="Border"
                        BasedOn="{StaticResource CardBorder}">
                    <Setter Property="BorderBrush"
                            Value="#D0D7DE"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}"
                                Value="True">
                            <Setter Property="BorderBrush"
                                    Value="#0969DA"/>
                            <Setter Property="Background"
                                    Value="#F0F7FF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionHeader}"
                    Text="文件列表"/>

                <!-- 文件列表 -->
                <ListView
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    AlternationCount="2"
                    BorderThickness="0"
                    IsSynchronizedWithCurrentItem="True"
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}"
                    SelectionMode="Single"
                    MouseDoubleClick="FileList_MouseDoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Padding"
                                    Value="8,6"/>
                            <Setter Property="Margin"
                                    Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex"
                                        Value="0">
                                    <Setter Property="Background"
                                            Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="ItemsControl.AlternationIndex"
                                        Value="1">
                                    <Setter Property="Background"
                                            Value="#F6F8FA"/>
                                </Trigger>
                                <Trigger Property="IsSelected"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="#0969DA"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridView.ColumnHeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Left"/>
                                    <Setter Property="Padding"
                                            Value="8,6"/>
                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>
                                    <Setter Property="FontSize"
                                            Value="12"/>
                                    <Setter Property="Background"
                                            Value="#F6F8FA"/>
                                    <Setter Property="BorderBrush"
                                            Value="#E1E4E8"/>
                                    <Setter Property="BorderThickness"
                                            Value="0,0,0,1"/>
                                </Style>
                            </GridView.ColumnHeaderContainerStyle>
                            <GridViewColumn Width="380">
                                <GridViewColumn.Header>
                                    <TextBlock Text="文件名"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="#24292F"
                                            Text="{Binding FileName}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100">
                                <GridViewColumn.Header>
                                    <TextBlock Text="大小"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="12"
                                            Foreground="#57606A"
                                            Text="{Binding SizeDisplay}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="170">
                                <GridViewColumn.Header>
                                    <TextBlock Text="最后修改"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="#57606A"
                                            Text="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm:ss'}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 拖拽提示 -->
                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#8B949E"
                    Text="将文件拖拽到此处上传"/>
            </Grid>
        </Border>

        <!-- 选中文件信息区：访问链接 -->
        <Border
            Grid.Row="5"
            Style="{StaticResource CardBorder}"
            Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Style="{StaticResource SectionHeader}"
                    Text="访问链接"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="10,8"
                        Background="#F6F8FA"
                        BorderBrush="#E1E4E8"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            Style="{StaticResource LinkText}"
                            Text="{Binding SelectedFileAccessUrl, Mode=OneWay}"/>
                    </Border>

                    <Button
                        Grid.Column="2"
                        Padding="12,6"
                        Command="{Binding CopyAccessUrlCommand}"
                        Content="复制"
                        FontSize="13"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <TextBlock
            Grid.Row="7"
            Padding="4,0"
            FontSize="12"
            Foreground="#57606A"
            Text="{Binding StatusText}"/>
    </Grid>
</Window>
