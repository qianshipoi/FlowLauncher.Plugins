<UserControl
    x:Class="FlowLauncher.Plugin.AliyunOss.Views.OssSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlowLauncher.Plugin.AliyunOss.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:DevToolkit.AliyunOss.ViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type={x:Type viewmodel:OssSettingsViewModel}}"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="Access Key ID:" />
        <TextBox
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,10"
            VerticalAlignment="Center"
            Text="{Binding AccessKeyId}" />

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="Accces Key Secret:" />
        <TextBox
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,10"
            VerticalAlignment="Center"
            Text="{Binding AccessKeySecret}" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="Endpoint:" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,10"
            VerticalAlignment="Center"
            Text="{Binding Endpoint}" />

        <StackPanel
            Grid.Row="3"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button Command="{Binding SaveCommand}" Content="Save" />
        </StackPanel>
    </Grid>

</UserControl>
