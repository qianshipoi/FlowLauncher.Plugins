<UserControl
    x:Class="FlowLauncher.Plugin.AliyunOss.Views.OssSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlowLauncher.Plugin.AliyunOss.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlowLauncher.Plugin.AliyunOss.ViewModel"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type={x:Type viewmodel:OssSettingsViewModel}}"
    d:DesignWidth="420"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="Access Key ID:" />
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,8">
            <TextBox Text="{Binding AccessKeyId, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="2,2,0,0" FontSize="11" Foreground="Gray" Text="明文保存，可直接查看" />
        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="Access Key Secret:" />
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8">
            <PasswordBox x:Name="SecretBox" PasswordChanged="SecretBox_PasswordChanged" />
            <TextBlock Margin="2,2,0,0" FontSize="11" Foreground="Gray" Text="{Binding AccessKeySecretHint}" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="Endpoint:" />
        <TextBox
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,10"
            VerticalAlignment="Center"
            Text="{Binding Endpoint}" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="连接测试:" />
        <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,8" Orientation="Horizontal">
            <Button MinWidth="72" Command="{Binding TestCommand}" Content="测试" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Text="{Binding TestStatus}" />
        </StackPanel>

        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Margin="5"
            VerticalAlignment="Center"
            Text="文件 MD5 元数据:" />
        <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,8">
            <CheckBox Content="上传时计算并写入 file-md5 元数据" IsChecked="{Binding ComputeFileMd5}" />
            <TextBlock
                Margin="2,2,0,0"
                FontSize="11"
                Foreground="Gray"
                Text="默认关闭。开启后每个文件要多完整读一遍磁盘，大文件会明显变慢。"
                TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Margin="5,0"
            FontSize="11"
            Foreground="Gray"
            Text="Secret 留空则不修改已保存的密钥；填入新值后点保存才会更新。"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="6"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button Content="Save" Click="Save_Click" />
        </StackPanel>
    </Grid>
</UserControl>
