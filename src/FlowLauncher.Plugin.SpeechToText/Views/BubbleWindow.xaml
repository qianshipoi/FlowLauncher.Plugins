<Window x:Class="FlowLauncher.Plugin.SpeechToText.Views.BubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ASR" Width="320" MinHeight="80" MaxHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="Height">
    <!--
        气泡自绘深色背景，按钮不能沿用宿主(Flow Launcher)主题样式：
        宿主主题的按钮模板为浅色底，叠加此处写死的白字前景会导致白底白字不可见。
        以下样式自带 ControlTemplate，完全接管渲染，确保深色底 + 浅色字。
    -->
    <Window.Resources>
        <!-- 通用按钮：深色半透明底 + 浅色字，hover/pressed 用叠加层实现，
             背景色仍由 Background 属性驱动，便于派生样式换色 -->
        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#2EFFFFFF"/>
            <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Border x:Name="StateMask" Background="#26FFFFFF" Opacity="0"
                                        CornerRadius="5" IsHitTestVisible="False"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StateMask" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="StateMask" Property="Opacity" Value="1"/>
                                <Setter TargetName="StateMask" Property="Background" Value="#26000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮（停止）：红色底 + 白字 -->
        <Style x:Key="BubbleDangerButton" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#59E05252"/>
            <Setter Property="BorderBrush" Value="#66FF6B6B"/>
        </Style>

        <!-- 标题栏关闭按钮：透明底 + 半透明白字 -->
        <Style x:Key="BubbleCloseButton" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Foreground" Value="#B3FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Border Background="#F2202020" CornerRadius="12" Padding="16" Margin="4"
            BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏：录音状态 + 关闭按钮 -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Ellipse x:Name="RecordDot" Width="10" Height="10" Fill="#FF4444" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.3" Duration="0:0:0.5"
                                                                     AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="✕"
                        Style="{StaticResource BubbleCloseButton}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </DockPanel>

            <!-- 时长 -->
            <TextBlock Text="{Binding DurationText}" Foreground="#66FFFFFF" FontSize="11"
                       Margin="0,4,0,8"/>

            <!-- 转写结果区域 -->
            <Border Background="#1AFFFFFF" CornerRadius="8" Padding="10" Margin="0,0,0,4"
                    MaxHeight="240">
                <ScrollViewer x:Name="ResultScroller" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ResultText}" Foreground="#E0E0E0" FontSize="13"
                               TextWrapping="Wrap" FontFamily="Microsoft YaHei"/>
                </ScrollViewer>
            </Border>

            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="CopyBtn" Content="复制" Margin="0,0,8,0"
                        Style="{StaticResource BubbleButton}"
                        Click="Copy_Click" Visibility="Collapsed"/>
                <Button x:Name="StopBtn" Content="停止"
                        Style="{StaticResource BubbleDangerButton}"
                        Click="Stop_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
