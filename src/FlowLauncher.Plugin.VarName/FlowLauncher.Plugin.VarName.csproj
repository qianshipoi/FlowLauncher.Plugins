<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputType>Library</OutputType>
		<PackageId>qianshipoi.FlowLauncher.Plugin.VarName</PackageId>
		<Description>Flow Launcher 插件：将中文转换为多种命名规范的变量名。</Description>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="VarName.UnitTest" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Flow.Launcher.Plugin" Version="5.1.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
		<PackageReference Include="OpenAI" Version="2.8.0" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
	</ItemGroup>

	<ItemGroup>
		<None Update="favicon.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="plugin.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
