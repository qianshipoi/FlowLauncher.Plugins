<UserControl x:Class="FlowLauncher.Plugin.VarName.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodel="clr-namespace:FlowLauncher.Plugin.VarName"
             mc:Ignorable="d"
             d:DesignHeight="350"
             d:DesignWidth="520"
             d:DataContext="{d:DesignInstance Type=viewmodel:SettingsViewModel}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- API 地址 -->
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="API 地址*:" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,6"
                 Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,32,0,0" FontSize="11" Foreground="Gray"
                   Text="只填基础地址，如 https://api.openai.com/v1/" />

        <!-- API Key -->
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="API Key*:" />
        <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,6" PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />

        <!-- 模型名称 -->
        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="模型名称*:" />
        <ComboBox x:Name="ModelComboBox" Grid.Row="2" Grid.Column="1" Margin="0,6"
                  IsEditable="True"
                  Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding ModelList}"
                  IsDropDownOpen="{Binding IsModelListOpen, Mode=TwoWay}"
                  StaysOpenOnEdit="True" />
        <Button Grid.Row="2" Grid.Column="2" Margin="6,6,0,6" Padding="8,4"
                Content="获取模型" Command="{Binding FetchModelsCommand}" IsEnabled="{Binding CanSubmit}" />

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="校验配置" Command="{Binding ValidateCommand}" Margin="0,0,8,0" IsEnabled="{Binding CanSubmit}" />
            <Button Content="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSubmit}" />
        </StackPanel>

        <!-- 提示信息 -->
        <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="{Binding ValidationMessage}" />
    </Grid>
</UserControl>
