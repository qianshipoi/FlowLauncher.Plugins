<Window
    x:Class="FlowLauncher.Plugin.S3.Views.ObjectMetadataWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="对象元数据"
    Width="760"
    Height="560"
    MinWidth="620"
    MinHeight="440"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,10"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Text="{Binding Header}"/>

        <Border Grid.Row="1"
                Padding="12"
                Background="#F6F8FA"
                BorderBrush="#E1E4E8"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Foreground="#57606A" Text="Content-Type"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ContentType}"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Foreground="#57606A" Text="Content-Encoding"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding ContentEncoding}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Foreground="#57606A" Text="大小"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding ContentLength}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" Foreground="#57606A" Text="最后修改"/>
                <TextBlock Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Text="{Binding LastModified}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6,0,0" Foreground="#57606A" Text="ETag"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0" Text="{Binding ETag}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0">
                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Text="用户元数据"/>
                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,6,0" Command="{Binding AddEntryCommand}" Content="新增"/>
                    <Button Click="RemoveSelected_Click" Content="删除选中"/>
                </StackPanel>
            </DockPanel>
            <DataGrid x:Name="MetadataGrid"
                      Grid.Row="1"
                      Margin="0,8,0,0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      ItemsSource="{Binding UserMetadata}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="220" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Header="Key"/>
                    <DataGridTextColumn Width="*" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Header="Value"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <DockPanel Grid.Row="5">
            <TextBlock VerticalAlignment="Center" Foreground="#57606A" Text="{Binding StatusText}"/>
            <Button DockPanel.Dock="Right" MinWidth="80" Command="{Binding SaveCommand}" Content="保存"/>
        </DockPanel>
    </Grid>
</Window>
