<UserControl x:Class="FlowLauncher.Plugin.PaperTodo.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,12">
            <TextBlock Text="Todo 完成行为"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <TextBlock Text="选择勾选完成后的处理方式。默认移到已完成区域末尾。"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Margin="0,2,0,8" />
            <ComboBox ItemsSource="{Binding CompletionPolicies}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding CompletionPolicy}"
                      Width="220"
                      HorizontalAlignment="Left" />

            <Separator Margin="0,16" />
            <TextBlock Text="提醒"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <CheckBox Content="启用到期提醒"
                      IsChecked="{Binding RemindersEnabled}"
                      Margin="0,8,0,4" />
            <CheckBox Content="提醒时播放系统提示音"
                      IsChecked="{Binding ReminderSoundEnabled}"
                      Margin="0,0,0,4" />
            <TextBlock Text="提醒只在 Flow Launcher 运行期间触发。"
                       Foreground="#666666"
                       FontSize="11" />

            <Separator Margin="0,16" />
            <TextBlock Text="图片与备份"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <CheckBox Content="自动压缩大图到 2048 像素以内"
                      IsChecked="{Binding AutoCompressImages}"
                      Margin="0,8,0,8" />
            <DockPanel Width="260" HorizontalAlignment="Left">
                <TextBlock Text="保留滚动备份数量"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />
                <TextBox Text="{Binding BackupRetentionCount, UpdateSourceTrigger=LostFocus}"
                         Width="80"
                         Padding="5"
                         HorizontalAlignment="Right" />
            </DockPanel>

            <Separator Margin="0,16" />
            <TextBlock Text="数据"
                       FontSize="14"
                       FontWeight="SemiBold" />
            <WrapPanel Margin="0,8,0,0">
                <Button Content="导入 PaperTodo"
                        Command="{Binding ImportPaperTodoCommand}"
                        Margin="0,0,8,8"
                        Padding="12,6" />
                <Button Content="导出数据库"
                        Command="{Binding ExportDatabaseCommand}"
                        Margin="0,0,8,8"
                        Padding="12,6" />
                <Button Content="恢复数据库"
                        Command="{Binding RestoreDatabaseCommand}"
                        Margin="0,0,8,8"
                        Padding="12,6" />
                <Button Content="打开数据目录"
                        Command="{Binding OpenDataFolderCommand}"
                        Margin="0,0,8,8"
                        Padding="12,6" />
            </WrapPanel>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#666666"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
