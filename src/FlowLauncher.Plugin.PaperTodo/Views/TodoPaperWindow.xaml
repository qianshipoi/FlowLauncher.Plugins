<Window x:Class="FlowLauncher.Plugin.PaperTodo.Views.TodoPaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="380" Height="520"
        MinWidth="300" MinHeight="320"
        Background="#F7F5F0"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E9E5DC" />
            <Setter Property="BorderBrush" Value="#D4CEC1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TitleBox"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Padding="6,4"
                     BorderThickness="0"
                     Background="Transparent"
                     LostKeyboardFocus="TitleBox_LostKeyboardFocus" />
            <Button x:Name="PinButton"
                    Grid.Column="1"
                    Content="置顶"
                    Margin="8,0,0,0"
                    Click="PinButton_Click" />
        </Grid>

        <Border DockPanel.Dock="Bottom"
                Margin="0,10,0,0"
                Padding="8"
                Background="#EEE9DF"
                CornerRadius="6">
            <StackPanel>
                <TextBox x:Name="NewItemBox"
                         Text="{Binding NewItemText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="52"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6"
                         PreviewKeyDown="NewItemBox_PreviewKeyDown" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="添加"
                            Click="AddItem_Click" />
                    <Button DockPanel.Dock="Right"
                            Content="撤销"
                            Margin="0,0,6,0"
                            Command="{Binding UndoCommand}"
                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               Foreground="#6E685E"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>

        <ListBox x:Name="TodoList"
                 ItemsSource="{Binding Items}"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AllowDrop="True"
                 PreviewMouseMove="TodoList_PreviewMouseMove"
                 Drop="TodoList_Drop"
                 DragOver="TodoList_DragOver">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="6,5"
                            Background="#FFFDF8"
                            BorderBrush="#E3DED3"
                            BorderThickness="1"
                            CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="="
                                       ToolTip="拖动排序"
                                       Cursor="SizeNS"
                                       Foreground="#8B8478"
                                       VerticalAlignment="Top"
                                       Margin="0,5,7,0"
                                       Tag="{Binding}"
                                       MouseLeftButtonDown="DragHandle_MouseLeftButtonDown" />
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsDone, Mode=OneWay}"
                                      Tag="{Binding}"
                                      Margin="0,4,7,0"
                                      VerticalAlignment="Top"
                                      Checked="DoneCheckBox_Changed"
                                      Unchecked="DoneCheckBox_Changed" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0,3"
                                     LostKeyboardFocus="ItemTextBox_LostKeyboardFocus">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="Foreground" Value="#928C82" />
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top"
                                        Margin="6,3,0,0">
                                <TextBlock Text="{Binding ReminderLabel}"
                                           Foreground="#B26A2E"
                                           FontSize="10"
                                           Margin="0,0,5,0" />
                                <TextBlock Text="{Binding LinkLabel}"
                                           Foreground="#55718E"
                                           FontSize="10"
                                           MaxWidth="90"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="4"
                                    Content="..."
                                    Tag="{Binding}"
                                    Margin="7,0,0,0"
                                    Padding="6,1"
                                    MinWidth="28"
                                    Click="ItemMenuButton_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
