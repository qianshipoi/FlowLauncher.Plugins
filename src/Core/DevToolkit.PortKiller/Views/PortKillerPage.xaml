<UserControl x:Class="DevToolkit.PortKiller.Views.PortKillerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="端口占用" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="查询端口占用的进程，选中后结束；查询记录自动保留最近 10 条。"
                       Style="{StaticResource PageSubtitle}"/>

            <TextBlock Text="查询" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PortBox" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MinWidth="140"
                                 VerticalContentAlignment="Center" KeyDown="Port_KeyDown"/>
                        <Button Content="查询" MinWidth="88" Margin="8,0,0,0" Command="{Binding QueryCommand}" IsDefault="True"/>
                        <TextBlock Text="最近" VerticalAlignment="Center" Margin="16,0,4,0"/>
                        <ComboBox ItemsSource="{Binding RecentQueries}" SelectedItem="{Binding Port}" MinWidth="120"/>
                        <Button Content="结束选中进程" MinWidth="110" Margin="16,0,0,0" Click="Kill_Click"/>
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#888888"/>
                </StackPanel>
            </Border>

            <TextBlock Text="占用进程" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <ListView ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          HorizontalContentAlignment="Stretch" BorderThickness="0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="进程名" DisplayMemberBinding="{Binding ProcessName}" Width="180"/>
                            <GridViewColumn Header="PID" DisplayMemberBinding="{Binding ProcessId}" Width="80"/>
                            <GridViewColumn Header="协议" DisplayMemberBinding="{Binding Protocol}" Width="70"/>
                            <GridViewColumn Header="本地" DisplayMemberBinding="{Binding LocalEndPoint}" Width="170"/>
                            <GridViewColumn Header="远程" DisplayMemberBinding="{Binding RemoteEndPoint}" Width="170"/>
                            <GridViewColumn Header="状态" DisplayMemberBinding="{Binding State}" Width="110"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
