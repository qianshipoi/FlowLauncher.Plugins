			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\DevToolkit.Abstractions\DevToolkit.Abstractions.csproj" />
	</ItemGroup>

</Project>
