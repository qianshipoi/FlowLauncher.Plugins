<Window x:Class="DevToolkit.Core.Wpf.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password Manager - 数据管理"
        Width="860" Height="560"
        WindowStartupLocation="CenterScreen"
        MinWidth="700" MinHeight="450">
    <DockPanel Margin="12">
        <!-- 顶部工具栏 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="导入" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding ImportCommand}"/>
            <Button Content="导出" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding ExportCommand}"/>
            <Button Content="添加" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding AddCommand}"/>
            <Button Content="编辑" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding EditCommand}"/>
            <Button Content="删除" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding DeleteCommand}"/>
            <Button Content="刷新" DockPanel.Dock="Right" Width="80" Margin="8,0,0,0" Command="{Binding RefreshCommand}"/>
            <TextBox VerticalAlignment="Center" Padding="4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <!-- 条目列表 -->
        <DataGrid ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  MouseDoubleClick="EntriesGrid_MouseDoubleClick"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="2*"/>
                <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="2*"/>
                <DataGridTextColumn Header="标签" Binding="{Binding Tags}" Width="1.5*"/>
                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 状态栏 -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="Gray"
                   Text="{Binding StatusText}"/>
    </DockPanel>
</Window>
