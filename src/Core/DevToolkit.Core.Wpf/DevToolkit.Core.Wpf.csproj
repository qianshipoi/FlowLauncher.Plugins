<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
		<PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../DevToolkit.AiChat/DevToolkit.AiChat.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- jsoneditor 静态资源单源：插件与 App 均通过 Content Link 复制到各自输出目录 -->
		<Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
