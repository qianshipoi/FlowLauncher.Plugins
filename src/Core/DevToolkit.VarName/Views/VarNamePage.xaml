<UserControl x:Class="DevToolkit.VarName.Views.VarNamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevToolkit.Toolbox.Views.Controls;assembly=DevToolkit.Toolbox">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="变量名" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="输入中文描述，AI 生成英文候选词，选择候选词后展开 camelCase、PascalCase 等命名规范变体。"
                       Style="{StaticResource PageSubtitle}"/>

            <TextBlock Text="中文描述" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/>
                <Button Grid.Column="1" Content="生成" MinWidth="88" Margin="8,0,0,0"
                        Command="{Binding GenerateCommand}" IsDefault="True"/>
                <Button Grid.Column="2" Content="刷新缓存" MinWidth="88" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
            <TextBlock x:Name="StatusText" Style="{StaticResource PageHint}"/>

            <TextBlock Text="候选词（点击展开变体）" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <ListBox x:Name="SuggestionsList" ItemsSource="{Binding Suggestions}"
                         BorderThickness="0" Background="Transparent" MinHeight="44"
                         SelectionChanged="Suggestions_SelectionChanged"/>
            </Border>

            <TextBlock Text="命名规范变体（点击行尾复制）" Style="{StaticResource SectionTitle}"/>
            <Border Style="{StaticResource Card}">
                <c:ResultRowsView x:Name="VariantRows"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
