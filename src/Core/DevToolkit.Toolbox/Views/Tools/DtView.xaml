<UserControl x:Class="DevToolkit.Toolbox.Views.Tools.DtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevToolkit.Toolbox.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="时间与时间戳" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="当前本地时间与 Unix 秒 / 毫秒时间戳，点击行尾复制。"
                       Style="{StaticResource PageSubtitle}"/>
            <Button Content="刷新当前时间" MinWidth="104" HorizontalAlignment="Left" Click="Refresh_Click"/>
            <TextBlock x:Name="StatusText" Style="{StaticResource PageHint}" Margin="0,8,0,8"/>
            <Border Style="{StaticResource Card}">
                <c:ResultRowsView x:Name="Rows"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
