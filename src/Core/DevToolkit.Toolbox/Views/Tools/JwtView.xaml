<UserControl x:Class="DevToolkit.Toolbox.Views.Tools.JwtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevToolkit.Toolbox.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <TextBlock Text="JWT 解码" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="仅解码展示 Header / Payload 与 exp、iat 时间声明，不校验签名。"
                       Style="{StaticResource PageSubtitle}"/>
            <TextBlock Text="Token" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="110"
                     VerticalContentAlignment="Top" FontFamily="Consolas" KeyDown="Input_KeyDown"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="解析" MinWidth="88" Click="Decode_Click" IsDefault="True"/>
                <Button x:Name="OpenPayloadButton" Content="Payload 进 JSON 编辑器" MinWidth="150" Margin="8,0,0,0"
                        IsEnabled="False" Click="OpenPayload_Click"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <c:ResultRowsView x:Name="Rows"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
