<UserControl x:Class="DevToolkit.Toolbox.Views.Tools.JsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <TextBlock Text="JSON 编辑器" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="粘贴 JSON 后在编辑器中查看、格式化、压缩与校验；留空打开则读取剪贴板内容。"
                       Style="{StaticResource PageSubtitle}"/>
            <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="180"
                     VerticalContentAlignment="Top" FontFamily="Consolas"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                <Button Content="在编辑器中打开" MinWidth="120" Click="Open_Click" IsDefault="True"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
