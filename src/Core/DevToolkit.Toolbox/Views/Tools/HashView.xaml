<UserControl x:Class="DevToolkit.Toolbox.Views.Tools.HashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevToolkit.Toolbox.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <TextBlock Text="文件哈希" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="单次读盘同时计算 MD5 / SHA1 / SHA256 / SHA384 / SHA512 / CRC32，支持大文件。"
                       Style="{StaticResource PageSubtitle}"/>
            <TextBlock Text="文件路径" Style="{StaticResource SectionTitle}"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" VerticalContentAlignment="Center" KeyDown="Path_KeyDown"/>
                <Button Grid.Column="1" Content="选择文件…" MinWidth="88" Margin="8,0,0,0" Click="Browse_Click"/>
                <Button Grid.Column="2" Content="计算" MinWidth="72" Margin="8,0,0,0" Click="Compute_Click" IsDefault="True"/>
            </Grid>
            <TextBlock x:Name="StatusText" Style="{StaticResource PageHint}"/>
            <Border Style="{StaticResource Card}">
                <c:ResultRowsView x:Name="Rows"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
