<Window
    x:Class="DevToolkit.AliyunOss.Views.TransferWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DevToolkit.AliyunOss.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:DevToolkit.AliyunOss.ViewModels"
    Title="传输"
    Width="232"
    Height="232"
    d:DataContext="{d:DesignInstance Type=vm:TransferViewModel}"
    mc:Ignorable="d"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 图标按钮：浅灰底、无边框。气泡圆底是纯白，浅灰能自然浮起，
             不依赖任何遮罩衬托 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#57606A" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="#F1F3F5"
                            CornerRadius="19">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E1E4E8" />
                                <Setter Property="Foreground" Value="#0969DA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D0D7DE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 取消按钮：与其它图标按钮同尺寸同圆角，仅用红色描边与叉号区分，
             不做成实心大红圆——那在白色圆底上过于抢眼，与整体克制风格不符 -->
        <Style
            x:Key="CancelIconButton"
            BasedOn="{StaticResource IconButton}"
            TargetType="Button">
            <Setter Property="Foreground" Value="#CF222E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bg"
                            Background="#FDF2F3"
                            BorderBrush="#F0C2C7"
                            BorderThickness="1"
                            CornerRadius="19">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#CF222E" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#CF222E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#A40E26" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#A40E26" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭（叉号），笔宽随按钮尺寸收敛 -->
        <Style x:Key="CloseGlyph" TargetType="Path">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Data" Value="M0,0 L14,14 M14,0 L0,14" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="2.1" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!-- 垃圾桶（取消入口）：桶盖线 + 桶身圆角矩形 + 提手，纯线条无弧段 -->
        <Style x:Key="TrashGlyph" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Data" Value="F1 M3,1 L12,1 M2,4 L13,4 M3.5,4 L3.5,13 Q3.5,15 5.5,15 L9.5,15 Q11.5,15 11.5,13 L11.5,4 M6,7 L6,12 M9,7 L9,12" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
        </Style>

        <!-- 对勾（确认取消） -->
        <Style x:Key="ConfirmGlyph" TargetType="Path">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Data" Value="M1,7 L5.5,11.5 L14,1.5" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="2.2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>

    <Grid
        x:Name="Root"
        Background="Transparent"
        MouseLeave="Root_MouseLeave"
        MouseMove="Root_MouseMove">
        <!-- 气泡层：直径由代码按状态缓动（紧凑 ↔ 展开），窗口本身尺寸固定，
             因此气泡始终居中；四周 22px 留白供投影扩散，投影挂在紧贴窗口边界的圆底上会被裁掉 -->
        <Grid
            x:Name="BubbleHost"
            Width="152"
            Height="152"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Grid.Effect>
                <DropShadowEffect
                    BlurRadius="18"
                    Direction="270"
                    Opacity="0.34"
                    ShadowDepth="4"
                    Color="#000000" />
            </Grid.Effect>

            <!-- 圆底：内缩半个环宽，与进度环内缘齐平 -->
            <Ellipse Margin="4" Fill="#FFFFFF" />

            <!-- 外边框即进度环 -->
            <controls:RingProgress
                x:Name="Ring"
                Foreground="#0969DA"
                IsIndeterminate="{Binding IsIndeterminate}"
                StrokeThickness="7"
                TrackBrush="#D8DEE6"
                Value="{Binding Percentage, Mode=OneWay}" />
        </Grid>

        <!-- 内容区：固定在展开态的内缘尺寸，与气泡缩放无关，文案不会跟着抖 -->
        <Grid
            x:Name="ContentHost"
            Width="132"
            Height="132"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <!-- 所有状态共用同一列布局：文字居上、按钮居下，按钮与文案同级而不是叠在它上面 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 上文：传输中为抬头 + 状态 + 速率；其余状态各有一行短文案 -->
            <StackPanel
                Grid.Row="0"
                VerticalAlignment="Center">
                <!-- 传输中：抬头（点按可切换百分比/字节） + 状态 + 速率 -->
                <StackPanel
                    x:Name="ProgressPanel"
                    HorizontalAlignment="Center">
                    <!-- 抬头做成按钮：点击在百分比与已传/总字节之间切换 -->
                    <Button
                        x:Name="HeadlineButton"
                        HorizontalAlignment="Center"
                        Command="{Binding ToggleHeadlineCommand}"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="点击切换百分比 / 已传字节"
                        Visibility="{Binding HasProgressHeadline, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="{Binding ProgressHeadlineFontSize}"
                                    FontWeight="SemiBold"
                                    Foreground="#24292F"
                                    Text="{Binding ProgressHeadline}" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock
                        Margin="0,1,0,0"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#57606A"
                        Text="{Binding StatusText}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        Foreground="#8B949E"
                        Text="{Binding SpeedText}"
                        Visibility="{Binding HasSpeedText, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- 非传输态：一行状态文案（失败 / 已取消 / 已存在 / 待选文件） -->
                <TextBlock
                    x:Name="StateText"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#57606A"
                    Text="{Binding StatusText}"
                    Visibility="Collapsed" />
            </StackPanel>

            <!-- 下文：按状态显示一组按钮，不再是浮在文字上的浮层 -->
            <Grid Grid.Row="1" HorizontalAlignment="Center">
                <!-- 传输中：取消按钮。同一颗按钮两级确认：
                     平时是垃圾桶（点击变对勾），确认态是对勾（点击真正取消） -->
                <Button
                    x:Name="CancelButton"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Opacity="0"
                    Style="{StaticResource CancelIconButton}"
                    ToolTip="取消传输"
                    Visibility="Collapsed">
                    <Grid>
                        <!-- 垃圾桶：默认态 -->
                        <Path x:Name="TrashGlyphPath" Style="{StaticResource TrashGlyph}" />
                        <!-- 对勾：确认态（再点一次才真正取消） -->
                        <Path
                            x:Name="ConfirmGlyphPath"
                            Style="{StaticResource ConfirmGlyph}"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- 传输完毕：主操作 + 关闭 -->
                <StackPanel
                    x:Name="DonePanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <!-- 打开文件所在位置：文件夹 + 外指箭头 -->
                    <Button
                        x:Name="RevealButton"
                        Command="{Binding OpenFolderCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="打开文件所在位置"
                        Visibility="{Binding DoneShowsReveal, Converter={StaticResource BoolToVis}}">
                        <Grid Width="18" Height="16">
                            <Path
                                Data="M0,4.5 A1.5,1.5 0 0 1 1.5,3 H6.2 L7.8,5 H15 A1.5,1.5 0 0 1 16.5,6.5 V13 A1.5,1.5 0 0 1 15,14.5 H1.5 A1.5,1.5 0 0 1 0,13 Z"
                                Fill="Transparent"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeLineJoin="Round"
                                StrokeThickness="1.5" />
                            <Path
                                Data="M12,0 H18 M18,0 V6 M18,0 L11.5,6.5"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.5" />
                        </Grid>
                    </Button>

                    <!-- 复制访问链接 -->
                    <Button
                        x:Name="CopyButton"
                        Margin="8,0,0,0"
                        Command="{Binding CopyLinkCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="复制访问链接"
                        Visibility="{Binding DoneShowsCopy, Converter={StaticResource BoolToVis}}">
                        <Grid Width="17" Height="15">
                            <Path
                                Data="M6,1 H14 A2,2 0 0 1 16,3 V11"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeEndLineCap="Round"
                                StrokeThickness="1.6" />
                            <Rectangle
                                Width="11"
                                Height="11"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Fill="#FFFFFF"
                                RadiusX="2.5"
                                RadiusY="2.5"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1.6" />
                        </Grid>
                    </Button>

                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="关闭">
                        <Path Style="{StaticResource CloseGlyph}" />
                    </Button>
                </StackPanel>

                <!-- 冲突：备份并替换 / 直接替换 / 取消 -->
                <StackPanel
                    x:Name="ConflictPanel"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Button
                        Command="{Binding ChooseBackupAndReplaceCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="备份并替换">
                        <Path
                            Width="16"
                            Height="18"
                            Data="M8,0 L16,3 V9 C16,13 12.5,16.4 8,18 C3.5,16.4 0,13 0,9 V3 Z M5,9 L7.5,11.5 L11.5,6.5"
                            Fill="Transparent"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeLineJoin="Round"
                            StrokeThickness="1.6" />
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ChooseReplaceCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="直接替换">
                        <Path
                            Width="15"
                            Height="17"
                            Data="M7.5,17 V2 M2,7.5 L7.5,2 L13,7.5"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="1.9" />
                    </Button>
                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding ChooseCancelReplaceCommand}"
                        Style="{StaticResource IconButton}"
                        ToolTip="取消上传">
                        <Path Style="{StaticResource CloseGlyph}" />
                    </Button>
                </StackPanel>

                <!-- 终止态（失败 / 已取消 / 等待）：只留关闭 -->
                <Button
                    x:Name="TerminalCloseButton"
                    HorizontalAlignment="Center"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource IconButton}"
                    Visibility="Collapsed">
                    <Path Style="{StaticResource CloseGlyph}" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
