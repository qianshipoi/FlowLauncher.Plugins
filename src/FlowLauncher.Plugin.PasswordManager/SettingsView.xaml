<UserControl x:Class="FlowLauncher.Plugin.PasswordManager.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="520">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- 通用设置 -->
            <TextBlock Text="通用设置" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8" VerticalAlignment="Center"
                           Text="剪贴板自动清除(ms):"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                         Text="{Binding Settings.ClearClipboardAfterMs, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8" VerticalAlignment="Center"
                           Text="最近条目显示数量:"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6"
                         Text="{Binding Settings.RecentItemsCount, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Separator Margin="0,16"/>

            <!-- 导出 -->
            <TextBlock Text="导出数据" FontSize="16" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                       Text="Excel 和 CSV 导出会解密密码为明文，请妥善保管导出文件。加密 DB 导出会复制数据库和密钥文件。"/>
            <WrapPanel>
                <Button Content="导出加密 DB" Margin="0,0,8,0" Click="ExportEncryptedDb_Click" Padding="12,6"/>
                <Button Content="导出 Excel" Margin="0,0,8,0" Click="ExportExcel_Click" Padding="12,6"/>
                <Button Content="导出 CSV" Click="ExportCsv_Click" Padding="12,6"/>
            </WrapPanel>

            <Separator Margin="0,16"/>

            <!-- 导入 -->
            <TextBlock Text="导入数据" FontSize="16" FontWeight="Bold" Margin="0,8,0,10"/>
            <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,10"
                       Text="导入文件需包含表头行：标题,用户名,密码,URL,标签,备注。重复条目不会自动去重。"/>
            <WrapPanel>
                <Button Content="导入 Excel" Margin="0,0,8,0" Click="ImportExcel_Click" Padding="12,6"/>
                <Button Content="导入 CSV" Click="ImportCsv_Click" Padding="12,6"/>
            </WrapPanel>

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="Gray"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
