<ui:ContentDialog x:Class="FlowLauncher.Plugin.PasswordManager.Views.ImportDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                  Title="导入密码数据"
                  PrimaryButtonText="导入"
                  CloseButtonText="取消"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="True">
    <StackPanel Width="420">
        <!-- 拖拽/点击选择区域 -->
        <Border x:Name="DropZone"
                Height="140"
                Margin="0,8,0,12"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="2"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop"
                MouseLeftButtonUp="DropZone_Click"
                Background="Transparent">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background"
                                    Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="点击选择文件，或将文件拖到这里" FontSize="14" HorizontalAlignment="Center"/>
                <TextBlock Text="支持 .xlsx / .csv" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Text="文件路径:" FontSize="12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        <TextBox Text="{Binding FilePath, Mode=OneWay}" IsReadOnly="True" Margin="0,4,0,0" Padding="4"/>

        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
    </StackPanel>
</ui:ContentDialog>
