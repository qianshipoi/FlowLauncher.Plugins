<ui:ContentDialog x:Class="FlowLauncher.Plugin.PasswordManager.Views.EditPasswordDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                  Title="{Binding WindowTitle}"
                  PrimaryButtonText="保存"
                  CloseButtonText="取消"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="True">
    <StackPanel Width="400">
        <Grid Margin="0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="标题*:"/>
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6" Padding="4"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="用户名*:"/>
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6" Padding="4"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="密码*:"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordInput" Grid.Column="0" Padding="4" VerticalContentAlignment="Center"
                             PasswordChanged="PasswordInput_PasswordChanged"/>
                <TextBox x:Name="PasswordVisible" Grid.Column="0" Padding="4" VerticalContentAlignment="Center"
                         Visibility="Collapsed" TextChanged="PasswordVisible_TextChanged"/>
                <CheckBox Grid.Column="1" Content="显示" Margin="8,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowPassword}"/>
            </Grid>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="URL:"/>
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6" Padding="4"
                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="标签:"/>
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,6" Padding="4"
                     Text="{Binding Tags, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="多个标签用逗号分隔"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,8" VerticalAlignment="Center" Text="备注:"/>
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6" Padding="4"
                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" Height="70" TextWrapping="Wrap"/>
        </Grid>
    </StackPanel>
</ui:ContentDialog>
