<ui:ContentDialog x:Class="FlowLauncher.Plugin.PasswordManager.Views.ExportDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                  Title="导出密码数据"
                  PrimaryButtonText="导出"
                  CloseButtonText="取消"
                  DefaultButton="Primary"
                  IsPrimaryButtonEnabled="True">
    <StackPanel Width="420">
        <!-- 格式选择 -->
        <TextBlock Text="导出格式:" FontWeight="SemiBold"/>
        <ComboBox ItemsSource="{Binding Formats}"
                  SelectedIndex="{Binding SelectedFormatIndex}"
                  Margin="0,6,0,0" Padding="4"/>

        <!-- 目标路径 -->
        <TextBlock Text="目标位置:" FontWeight="SemiBold" Margin="0,14,0,0"/>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Padding="4" IsReadOnly="True"/>
            <Button Grid.Column="1" Content="浏览..." Margin="8,0,0,0" Padding="8,4"
                    Command="{Binding BrowseCommand}"/>
        </Grid>

        <TextBlock Text="加密数据库导出会同时生成同名 .dbkey 密钥文件（DPAPI 保护）。"
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,12,0,0"/>
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="Gray" Margin="0,8,0,0"/>
    </StackPanel>
</ui:ContentDialog>