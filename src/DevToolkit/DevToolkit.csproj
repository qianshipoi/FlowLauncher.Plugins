<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net9.0-windows7.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- 机器上仅安装更高版本的 .NET 桌面运行时（如 10.x）时允许向前滚动，免去单独装 9.x -->
		<RollForward>LatestMajor</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="iNKORE.UI.WPF" Version="1.2.8" />
		<PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\DevToolkit.Abstractions\DevToolkit.Abstractions.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.Core.Wpf\DevToolkit.Core.Wpf.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.PasswordManager\DevToolkit.PasswordManager.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.PortKiller\DevToolkit.PortKiller.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.SpeechToText\DevToolkit.SpeechToText.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.Toolbox\DevToolkit.Toolbox.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.VarName\DevToolkit.VarName.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.AliyunOss\DevToolkit.AliyunOss.csproj" />
		<ProjectReference Include="..\Core\DevToolkit.OpenDirectory\DevToolkit.OpenDirectory.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="..\Core\DevToolkit.Core.Wpf\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- 运行时第三方插件目录：PluginManager 启动时扫描 {BaseDir}\Plugins\*.dll 动态加载 -->
	<Target Name="EnsurePluginDirectory" AfterTargets="Build">
		<MakeDir Directories="$(OutputPath)Plugins" />
	</Target>

</Project>
