<UserControl x:Class="DevToolkit.Views.OssPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="24,16" MaxWidth="860" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="阿里云 OSS" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <TextBlock Text="AccessKey / Endpoint 设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="AccessKeyId" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Settings.AccessKeyId, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="AccessKeySecret" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.AccessKeySecret, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="Endpoint" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
            </Grid>
            <Button Content="保存设置" MinWidth="80" HorizontalAlignment="Left" Command="{Binding Settings.SaveCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,10">
            <Button Content="加载 Buckets" MinWidth="96" Command="{Binding LoadBucketsCommand}"/>
            <TextBlock Text="Bucket" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <ComboBox ItemsSource="{Binding Buckets}" SelectedItem="{Binding SelectedBucket}" MinWidth="220"/>
            <TextBlock Text="Prefix" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <TextBox Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" MinWidth="160" VerticalContentAlignment="Center"/>
            <Button Content="列出对象" MinWidth="88" Margin="8,0,0,0" Command="{Binding LoadObjectsCommand}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="#888888" VerticalAlignment="Center"/>
            <ProgressBar Grid.Column="1" Width="220" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                         Minimum="0" Maximum="1" Value="{Binding DownloadProgress}"
                         Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="复制下载链接" MinWidth="100" Margin="0,0,8,0" Command="{Binding CopyLinkCommand}"/>
                <Button Content="下载" MinWidth="72" Command="{Binding DownloadCommand}"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="3" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" MinHeight="220"/>
    </Grid>
</UserControl>
