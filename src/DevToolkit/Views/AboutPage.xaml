<UserControl x:Class="DevToolkit.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16">
            <TextBlock Text="关于" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="DevToolkit — 开发者工具箱" Style="{StaticResource PageSubtitle}"/>

            <!-- 版本信息 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="版本" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" x:Name="VersionText"/>
                        <TextBlock Grid.Row="1" Text="运行时" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText"/>
                        <TextBlock Grid.Row="2" Text="操作系统" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="OsText"/>
                        <TextBlock Grid.Row="3" Text=".NET" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DotnetText"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 已加载插件 -->
            <TextBlock Text="已加载插件" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="以插件形式提供功能的模块列表。" Style="{StaticResource PageHint}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <ItemsControl x:Name="PluginList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Id}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 目录快捷跳转 -->
            <TextBlock Text="目录快捷跳转" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="点击按钮在文件资源管理器中打开对应目录。" Style="{StaticResource PageHint}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="程序目录" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="AppDirText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4"/>
                        <Button Grid.Column="2" Content="打开" Padding="12,4" Margin="8,2"
                                Click="OpenAppDir_Click"/>

                        <TextBlock Grid.Row="1" Text="数据目录" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DataDirText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="打开" Padding="12,4" Margin="8,2"
                                Click="OpenDataDir_Click"/>

                        <TextBlock Grid.Row="2" Text="日志目录" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LogsDirText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="打开" Padding="12,4" Margin="8,2"
                                Click="OpenLogsDir_Click"/>

                        <TextBlock Grid.Row="3" Text="录音文件" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RecordingsDirText" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,4"/>
                        <Button Grid.Row="3" Grid.Column="2" Content="打开" Padding="12,4" Margin="8,2"
                                Click="OpenRecordingsDir_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
