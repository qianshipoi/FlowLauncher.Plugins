<UserControl x:Class="DevToolkit.Views.VarNamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="中文描述" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" MinWidth="420"
                     VerticalContentAlignment="Center" KeyDown="Input_KeyDown"/>
            <Button Content="生成" MinWidth="88" Margin="8,0,0,0" Command="{Binding GenerateCommand}"/>
            <Button Content="刷新缓存" MinWidth="88" Margin="8,0,0,0" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#888888" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="候选词（点击展开命名规范变体）" Margin="0,0,0,6"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding Suggestions}" MinHeight="120" MaxHeight="200"
                 SelectionMode="Single"
                 MouseDoubleClick="Suggestion_DoubleClick"
                 PreviewMouseLeftButtonDown="Suggestion_Click"
                 BorderThickness="1"/>

        <TextBlock Grid.Row="3" Text="命名规范变体（点击复制）" Margin="16,12,0,6"/>
        <ListBox Grid.Row="4" ItemsSource="{Binding Variants}" HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="Variant_DoubleClick"
                 PreviewMouseLeftButtonDown="Variant_Click" Margin="16,0,0,0" BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="#888888"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
