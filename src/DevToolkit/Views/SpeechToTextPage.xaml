<UserControl x:Class="DevToolkit.Views.SpeechToTextPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- 录音中全屏半透明遮罩 -->
        <Border x:Name="RecordingOverlay" Visibility="Collapsed"
                Panel.ZIndex="1" IsHitTestVisible="False">
            <Border.Background>
                <SolidColorBrush x:Name="OverlayBrush" Color="Black" Opacity="0.03"/>
            </Border.Background>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="语音转文字" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="点击麦克风按钮开始录音，支持实时流式识别，录音文件和结果自动保存到历史记录。"
                           Style="{StaticResource PageSubtitle}"/>

                <!-- 录音控制区 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Height="80">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- 麦克风按钮：录音时透明度动画 -->
                                <Button x:Name="RecordButton" Width="56" Height="56"
                                        Click="RecordButton_Click" Cursor="Hand"
                                        HorizontalAlignment="Center">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse Fill="#E8E8E8" Width="56" Height="56"/>
                                                <Ellipse x:Name="RecDot" Fill="#FF4444" Width="56" Height="56"
                                                         Opacity="0"/>
                                                <TextBlock Text="🎤" FontSize="24" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RecDot" Property="Opacity" Value="0.1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="1" To="0.4" Duration="0:0:0.8"
                                                                                 AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"
                                   FontSize="14" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding DurationText}" HorizontalAlignment="Center"
                                   Foreground="#888" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 转写结果 -->
                <TextBlock Text="转写结果" Style="{StaticResource SectionTitle}"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <TextBox x:Name="ResultBox" Text="{Binding ResultText, Mode=TwoWay}"
                                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"
                                 VerticalScrollBarVisibility="Auto" FontSize="14"
                                 IsReadOnly="True" Background="Transparent" BorderThickness="0"/>
                        <TextBlock Text="转写结果将显示在这里" Foreground="#AAA" Margin="4"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasResult}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 操作按钮 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="复制结果" Padding="16,6" Margin="0,0,8,0"
                            Click="CopyResult_Click"/>
                    <Button Content="清空" Padding="16,6" Click="ClearResult_Click"/>
                </StackPanel>

                <!-- 历史记录 -->
                <TextBlock Text="历史记录" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource PageHint}">
                    <Run Text="共 "/>
                    <Run Text="{Binding History.Count, Mode=OneWay}"/>
                    <Run Text=" 条记录"/>
                </TextBlock>
                <Border Style="{StaticResource Card}">
                    <ListBox ItemsSource="{Binding History}" BorderThickness="0"
                             Background="Transparent" MaxHeight="400"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="History_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm'}"
                                               Foreground="#888" VerticalAlignment="Center" Margin="12,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat='mm\\:ss'}"
                                               Foreground="#888" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
