<UserControl x:Class="DevToolkit.Views.TranslatorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="翻译（中 → 英）" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <TextBlock Text="API 设置" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="模型" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Settings.ModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="API 地址" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.ApiUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="API Key" VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.ApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="保存" MinWidth="80" Command="{Binding Settings.SaveCommand}"/>
                <Button Content="验证连通" MinWidth="80" Margin="8,0,0,0" Command="{Binding Settings.ValidateCommand}"/>
                <TextBlock Text="{Binding Settings.ValidationMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888888"/>
            </StackPanel>

            <TextBlock Text="翻译" FontSize="15" FontWeight="SemiBold" Margin="0,12,0,6"/>
            <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"
                     AcceptsReturn="True" MinHeight="64" VerticalContentAlignment="Top"
                     KeyDown="Input_KeyDown"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,4">
                <Button Content="翻译" MinWidth="88" Command="{Binding TranslateCommand}"/>
                <Button Content="复制结果" MinWidth="88" Margin="8,0,0,0" Command="{Binding CopyResultCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888888"/>
            </StackPanel>
            <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="64"
                     VerticalContentAlignment="Top" Margin="0,4,0,12"/>

            <TextBlock Text="历史（点击复制，右键删除）" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <ListBox ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch" MaxHeight="240"
                     MouseDoubleClick="History_DoubleClick"
                     KeyDown="History_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding TranslatedText, Mode=OneWay}"/>
                            <Run Text="  ←  " Foreground="#AAAAAA"/>
                            <Run Text="{Binding OriginalText, Mode=OneWay}" Foreground="#888888"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
