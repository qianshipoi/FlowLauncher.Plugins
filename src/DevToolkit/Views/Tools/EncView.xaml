<UserControl x:Class="DevToolkit.Views.Tools.EncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DevToolkit.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="编码转换" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="URL / Base64 / HTML 实体 / 十六进制编解码；解码结果仅在有效且与输入不同时显示。"
                       Style="{StaticResource PageSubtitle}"/>
            <TextBlock Text="输入文本" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="72"
                     VerticalContentAlignment="Top" KeyDown="Input_KeyDown"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="转换" MinWidth="88" Click="Convert_Click" IsDefault="True"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888888"/>
            </StackPanel>
            <Border Style="{StaticResource Card}">
                <c:ResultRowsView x:Name="Rows"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
