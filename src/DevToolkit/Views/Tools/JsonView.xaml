<UserControl x:Class="DevToolkit.Views.Tools.JsonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,16" MaxWidth="760" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="InputBox" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="160"
                 VerticalContentAlignment="Top" FontFamily="Consolas"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,4">
            <Button Content="在编辑器中打开" MinWidth="120" Click="Open_Click" IsDefault="True"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888888"/>
        </StackPanel>
        <TextBlock Grid.Row="2" Text="提示：留空执行会读取剪贴板中的 JSON；编辑器支持格式化、压缩、校验与复制。"
                   Foreground="#AAAAAA" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
