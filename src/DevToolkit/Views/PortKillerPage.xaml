<Page x:Class="DevToolkit.Views.PortKillerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="端口占用">
    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="端口" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" MinWidth="140"
                     VerticalContentAlignment="Center" KeyDown="Port_KeyDown"/>
            <Button Content="查询" Margin="8,0,0,0" MinWidth="88" Command="{Binding QueryCommand}" IsDefault="True"/>
            <TextBlock Text="最近：" VerticalAlignment="Center" Margin="16,0,4,0"/>
            <ComboBox ItemsSource="{Binding RecentQueries}" SelectedItem="{Binding Port}" MinWidth="120"/>
            <Button Content="结束选中进程" Margin="16,0,0,0" MinWidth="110" Click="Kill_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="#888888" Margin="0,0,0,8"/>

        <ListView Grid.Row="2" ItemsSource="{Binding Processes}"
                  SelectedItem="{Binding SelectedProcess}"
                  HorizontalContentAlignment="Stretch">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="进程名" DisplayMemberBinding="{Binding ProcessName}" Width="180"/>
                    <GridViewColumn Header="PID" DisplayMemberBinding="{Binding ProcessId}" Width="80"/>
                    <GridViewColumn Header="协议" DisplayMemberBinding="{Binding Protocol}" Width="70"/>
                    <GridViewColumn Header="本地" DisplayMemberBinding="{Binding LocalEndPoint}" Width="170"/>
                    <GridViewColumn Header="远程" DisplayMemberBinding="{Binding RemoteEndPoint}" Width="170"/>
                    <GridViewColumn Header="状态" DisplayMemberBinding="{Binding State}" Width="110"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
