<UserControl x:Class="DevToolkit.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="DataDirText" Style="{StaticResource PageSubtitle}"/>

            <TextBlock Text="工具箱 · 启用的工具" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="取消勾选后，对应工具将从左侧导航中移除；更改即时生效。"
                       Style="{StaticResource PageHint}"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <UniformGrid Columns="2">
                    <CheckBox Content="GUID 生成（guid）"     IsChecked="{Binding EnableGuid}"  Margin="4,6,16,6"/>
                    <CheckBox Content="JSON 编辑器（json）"   IsChecked="{Binding EnableJson}"  Margin="4,6,16,6"/>
                    <CheckBox Content="文件哈希（fhash）"     IsChecked="{Binding EnableFhash}" Margin="4,6,16,6"/>
                    <CheckBox Content="时间与时间戳（dt）"    IsChecked="{Binding EnableDt}"    Margin="4,6,16,6"/>
                    <CheckBox Content="编码转换（enc）"       IsChecked="{Binding EnableEnc}"   Margin="4,6,16,6"/>
                    <CheckBox Content="密码生成（pw）"        IsChecked="{Binding EnablePw}"    Margin="4,6,16,6"/>
                    <CheckBox Content="进制转换（base）"      IsChecked="{Binding EnableBase}"  Margin="4,6,16,6"/>
                    <CheckBox Content="时间戳转日期（ts）"    IsChecked="{Binding EnableTs}"    Margin="4,6,16,6"/>
                    <CheckBox Content="JWT 解码（jwt）"       IsChecked="{Binding EnableJwt}"   Margin="4,6,16,6"/>
                    <CheckBox Content="Cron 解析（cron）"     IsChecked="{Binding EnableCron}"  Margin="4,6,16,6"/>
                </UniformGrid>
            </Border>

            <TextBlock Text="变量名 · AI 配置" Style="{StaticResource SectionTitle}"/>
            <TextBlock Text="变量名生成使用 OpenAI 兼容接口，与 Flow Launcher 插件的配置相互独立。"
                       Style="{StaticResource PageHint}"/>
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="VarNameSection">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="模型" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                        <TextBlock Grid.Row="1" Text="API 地址" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                        <TextBlock Grid.Row="2" Text="API Key" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="ApiKeyBox" Grid.Row="2" Grid.Column="1" Margin="0,2"
                                     PasswordChanged="ApiKeyBox_PasswordChanged"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="保存" MinWidth="80" Command="{Binding SaveCommand}"/>
                        <Button Content="验证连通" MinWidth="80" Margin="8,0,0,0" Command="{Binding ValidateCommand}"/>
                        <TextBlock Text="{Binding ValidationMessage}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#888888"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
