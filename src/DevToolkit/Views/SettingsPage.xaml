<UserControl x:Class="DevToolkit.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uic="clr-namespace:iNKORE.UI.WPF.Modern.Controls;assembly=iNKORE.UI.WPF.Modern.Controls">
    <!-- 每个插件分区 = 一个组件库 SettingsExpander 分组：默认折叠只显示名称，展开显示配置卡片（SettingsCard/ToggleSwitch） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="DataDirText" Style="{StaticResource PageSubtitle}" Margin="0,0,0,12"/>

            <ItemsControl x:Name="SectionsHost">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 表单视图放入 Items（展开区）：SettingsExpander 的 Content 会渲染在标题区且不随折叠隐藏 -->
                        <uic:SettingsExpander Header="{Binding Title}"
                                              Description="{Binding Description}"
                                              IsExpanded="False"
                                              Margin="0,0,0,10"
                                              HorizontalContentAlignment="Stretch"
                                              ItemContainerStyleSelector="{x:Null}">
                            <uic:SettingsExpander.Items>
                                <ContentControl Content="{Binding View}"/>
                            </uic:SettingsExpander.Items>
                        </uic:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
