<UserControl x:Class="DevToolkit.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16" MaxWidth="680" HorizontalAlignment="Left">
            <TextBlock Text="设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="DataDirText" Foreground="#888888" Margin="0,0,0,16"/>

            <TextBlock Text="工具箱 · 启用的工具" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Text="取消勾选后，对应工具不再出现在工具列表中；更改即时保存。"
                       TextWrapping="Wrap" Foreground="#888888" Margin="0,0,0,10"/>
            <UniformGrid Columns="2">
                <CheckBox Content="GUID 生成（guid）"     IsChecked="{Binding EnableGuid}"  Margin="0,4,16,6"/>
                <CheckBox Content="JSON 编辑器（json）"   IsChecked="{Binding EnableJson}"  Margin="0,4,16,6"/>
                <CheckBox Content="文件哈希（fhash）"     IsChecked="{Binding EnableFhash}" Margin="0,4,16,6"/>
                <CheckBox Content="时间与时间戳（dt）"    IsChecked="{Binding EnableDt}"    Margin="0,4,16,6"/>
                <CheckBox Content="编码转换（enc）"       IsChecked="{Binding EnableEnc}"   Margin="0,4,16,6"/>
                <CheckBox Content="密码生成（pw）"        IsChecked="{Binding EnablePw}"    Margin="0,4,16,6"/>
                <CheckBox Content="进制转换（base）"      IsChecked="{Binding EnableBase}"  Margin="0,4,16,6"/>
                <CheckBox Content="时间戳转日期（ts）"    IsChecked="{Binding EnableTs}"    Margin="0,4,16,6"/>
                <CheckBox Content="JWT 解码（jwt）"       IsChecked="{Binding EnableJwt}"   Margin="0,4,16,6"/>
                <CheckBox Content="Cron 解析（cron）"     IsChecked="{Binding EnableCron}"  Margin="0,4,16,6"/>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
